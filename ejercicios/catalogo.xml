<?xml version="1.0" encoding="UTF-8"?>

<!-- 
Crea biblioteca.xsd para que se valide el siguiente XML y cumpla con las restricciones indicadas.

RESTRICCIONES PARA EL XSD:
X Raíz: catalogo con atributo editorial obligatorio
X De 1 a n elementos seccion
- Cada seccion tiene:
    X Atributo genero obligatorio
    X De 1 a 20 libro
- Cada libro tiene:
    X Atributos: isbn (obligatorio), estado (obligatorio)
    - isbn debe seguir el patrón: L seguido de 4 dígitos
    - estado solo puede ser: disponible, prestado, reservado
    X Elementos en orden: titulo (obligatorio), sinopsis (opcional), paginas (obligatorio), autores (obligatorio)
    - paginas debe ser un entero entre 1 y 9999
    X autores contiene 1-n elementos autor con atributos nacionalidad y siglo obligatorios
    - nacionalidad solo puede ser: española, francesa, inglesa, alemana, italiana
NOTA: Tienes que hacer al menos 3 tipos con nombre aplicados a elementos o atributos.
-->
<catalogo editorial="LibroMundo"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xmlns="https://tierno.es/catalogo"
xsi:schemaLocation="https://tierno.es/catalogo catalogo.xsd">

  <seccion genero="novela">
    <libro isbn="L0001" estado="prestado">
      <titulo>El nombre de la rosa</titulo>
      <sinopsis>Un monje investiga crímenes en una abadía medieval</sinopsis>
      <paginas>5120</paginas>
      <autores>
        <autor nacionalidad="italiana" siglo="XX">Umberto Eco</autor>
      </autores>
     
    </libro>
    <libro isbn="L0002" estado="prestado">
      <titulo>Fortunata y Jacinta</titulo>
      <paginas>880</paginas>
      <autores>
        <autor nacionalidad="española" siglo="XIX">Benito Pérez Galdós</autor>
      </autores>
    </libro>
  </seccion>

  <seccion genero="poesia">
    <libro isbn="L0003" estado="reservado">
      <titulo>Las flores del mal</titulo>
      <sinopsis>Colección de poemas simbolistas sobre belleza y decadencia</sinopsis>
      <paginas>320</paginas>
      <autores>
        <autor nacionalidad="alemana" siglo="XIX">Charles Baudelaire</autor>
        <autor nacionalidad="francesa" siglo="XIX">Théophile Gautier</autor>
      </autores>
    </libro>
  </seccion>

</catalogo>